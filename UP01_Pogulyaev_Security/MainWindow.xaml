<Window x:Class="UP01_Pogulyaev_Security.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Верхняя строка: кнопка "Назад" и переключение темы -->
        <Button x:Name="ButtonBack" Content="Назад" Grid.Row="0"
                ToolTip="Вернуться на предыдущую страницу"
                HorizontalAlignment="Left" Width="100"
                Click="ButtonBack_Click"/>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="Тема:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="ComboBoxTheme" Width="130" MinWidth="130"
                      ToolTip="Выбор темы оформления приложения"
                      SelectionChanged="ComboBoxTheme_SelectionChanged">
                <ComboBoxItem Content="Светлая" Tag="Light"/>
                <ComboBoxItem Content="Тёмная" Tag="Dark"/>
            </ComboBox>
        </StackPanel>

        <!-- Центральная строка: фрейм со страницами приложения -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <!-- Нижняя строка: текущие дата и время -->
        <TextBlock x:Name="DateTimeNow" Grid.Row="2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
    </Grid>
</Window>
