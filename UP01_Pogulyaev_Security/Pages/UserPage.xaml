<Page x:Class="UP01_Pogulyaev_Security.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователи" Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Сотрудники — пользователи системы"
                   Style="{StaticResource HeaderTextStyle}"/>

        <!-- Панель поиска, сортировки и фильтрации -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Введите ФИО для поиска:" FontSize="12" VerticalAlignment="Center"/>
            <TextBox x:Name="fioFilterTextBox" Margin="7" MinWidth="140"
                     ToolTip="Поиск по ФИО"
                     TextChanged="fioFilterTextBox_TextChanged"/>
            <TextBlock Text="Сортировка по ФИО:" Margin="10,0,0,0" FontSize="12"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="sortComboBox" MinWidth="130" SelectedIndex="0"
                      ToolTip="Порядок сортировки"
                      SelectionChanged="sortComboBox_SelectionChanged">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>
            <CheckBox x:Name="onlyAdminCheckBox" Content="Только администраторы"
                      IsChecked="False" ToolTip="Показать только администраторов"
                      Checked="onlyAdminCheckBox_Checked"
                      Unchecked="onlyAdminCheckBox_Unchecked"/>
            <Button x:Name="clearFiltersButton" Content="Очистить фильтр" Width="140"
                    ToolTip="Сбросить поиск, сортировку и фильтрацию"
                    Click="clearFiltersButton_Click"/>
        </WrapPanel>

        <!-- Список пользователей с фотографиями -->
        <ListView x:Name="ListUser" Grid.Row="2" BorderThickness="0"
                  HorizontalContentAlignment="Center" Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#0198AF" BorderThickness="1" CornerRadius="8"
                            Margin="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="180"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Width="180" TextWrapping="Wrap"
                                       TextAlignment="Center" HorizontalAlignment="Center"
                                       FontSize="15" FontWeight="Bold" Text="{Binding FIO}"/>
                            <Image Grid.Row="1" Width="160" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" Margin="0,6">
                                <Image.Source>
                                    <Binding Path="Photo">
                                        <Binding.TargetNullValue>
                                            <ImageSource>/images/default.png</ImageSource>
                                        </Binding.TargetNullValue>
                                        <Binding.FallbackValue>
                                            <ImageSource>/images/default.png</ImageSource>
                                        </Binding.FallbackValue>
                                    </Binding>
                                </Image.Source>
                            </Image>
                            <TextBlock Grid.Row="2" Width="180" TextAlignment="Center"
                                       HorizontalAlignment="Center" FontSize="13"
                                       Text="{Binding Department}"/>
                            <TextBlock Grid.Row="3" Width="180" TextAlignment="Center"
                                       HorizontalAlignment="Center" FontSize="13"
                                       FontWeight="Bold" Text="{Binding Role}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
