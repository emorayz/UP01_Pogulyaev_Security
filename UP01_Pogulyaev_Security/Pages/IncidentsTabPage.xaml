<Page x:Class="UP01_Pogulyaev_Security.Pages.IncidentsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Инциденты ИБ" Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска и фильтрации инцидентов -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Поиск по названию:" FontSize="12" VerticalAlignment="Center"/>
            <TextBox x:Name="nameFilterTextBox" Margin="7" MinWidth="140"
                     ToolTip="Поиск по названию инцидента"
                     TextChanged="nameFilterTextBox_TextChanged"/>
            <TextBlock Text="Статус:" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"/>
            <ComboBox x:Name="statusComboBox" MinWidth="120" SelectedIndex="0"
                      ToolTip="Фильтр по статусу инцидента"
                      SelectionChanged="statusComboBox_SelectionChanged">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="Открыт"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Закрыт"/>
            </ComboBox>
            <Button x:Name="clearFiltersButton" Content="Очистить фильтр" Width="140"
                    ToolTip="Сбросить поиск и фильтрацию"
                    Click="clearFiltersButton_Click"/>
        </WrapPanel>

        <DataGrid Grid.Row="1" x:Name="DataGridIncident"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  ToolTip="Таблица инцидентов информационной безопасности">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding ThreatCategory.Name}" Width="150"/>
                <DataGridTextColumn Header="Критичность" Binding="{Binding Severity}" Width="85"/>
                <DataGridTextColumn Header="Зарегистрировал" Binding="{Binding User.FIO}" Width="160"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80"/>
                <DataGridTemplateColumn Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" Content="Редактировать" Width="110"
                                    ToolTip="Редактировать данные" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ButtonAdd" ToolTip="Добавить данные"
                    Content="Добавить" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonDel" ToolTip="Удалить выбранные записи"
                    Content="Удалить" Style="{StaticResource DangerButtonStyle}"
                    Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>
