<Page x:Class="UP01_Pogulyaev_Security.Pages.UsersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица пользователей" Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" x:Name="DataGridUser"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  ToolTip="Таблица пользователей системы">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="100"/>
                <DataGridTextColumn Header="Пароль (хэш)" Binding="{Binding Password}" Width="150"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="70"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="*"/>
                <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="110"/>
                <DataGridTemplateColumn Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="ButtonEdit" Content="Редактировать" Width="110"
                                    ToolTip="Редактировать данные" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ButtonAdd" ToolTip="Добавить данные"
                    Content="Добавить" Click="ButtonAdd_Click"/>
            <Button x:Name="ButtonDel" ToolTip="Удалить выбранные записи"
                    Content="Удалить" Style="{StaticResource DangerButtonStyle}"
                    Click="ButtonDel_Click"/>
        </StackPanel>
    </Grid>
</Page>
