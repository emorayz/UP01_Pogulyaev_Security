<Page x:Class="UP01_Pogulyaev_Security.Pages.AddCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Категория угрозы" Loaded="Page_Loaded">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="620">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Категория угрозы ИБ"
                   Style="{StaticResource HeaderTextStyle}"/>

        <TextBox x:Name="TBCategoryName" Grid.Row="1" Text="{Binding Name}"
                 ToolTip="Введите название категории, например: Фишинг" MaxLength="200"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ButtonSaveCategory" Content="Сохранить"
                    ToolTip="Сохранить данные" Click="ButtonSaveCategory_Click"/>
            <Button x:Name="ButtonClean" Content="Очистить"
                    ToolTip="Очистить поле" Click="ButtonClean_Click"/>
        </StackPanel>
    </Grid>
</Page>
