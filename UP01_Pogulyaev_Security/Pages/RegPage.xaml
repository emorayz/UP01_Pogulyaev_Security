<Page x:Class="UP01_Pogulyaev_Security.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация" Loaded="Page_Loaded">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="620">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Регистрация пользователя"
                   Style="{StaticResource HeaderTextStyle}"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Логин"/>
        <Grid Grid.Row="1" Grid.Column="1">
            <TextBox x:Name="txtbxLog" ToolTip="Введите логин" TextChanged="txtbxLog_TextChanged"/>
            <TextBlock x:Name="lblLogHitn" Text="Введите логин" Foreground="Gray"
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Grid>

        <Label Grid.Row="2" Grid.Column="0" Content="Пароль"/>
        <Grid Grid.Row="2" Grid.Column="1">
            <PasswordBox x:Name="passBxFrst" ToolTip="Минимум 6 символов, английская раскладка, хотя бы одна цифра"
                         PasswordChanged="passBxFrst_PasswordChanged"/>
            <TextBlock x:Name="lblPassHitn" Text="Введите пароль" Foreground="Gray"
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Grid>

        <Label Grid.Row="3" Grid.Column="0" Content="Подтверждение"/>
        <Grid Grid.Row="3" Grid.Column="1">
            <PasswordBox x:Name="passBxScnd" ToolTip="Повторите пароль"
                         PasswordChanged="passBxScnd_PasswordChanged"/>
            <TextBlock x:Name="lblPassSecHitn" Text="Повторите пароль" Foreground="Gray"
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Grid>

        <Label Grid.Row="4" Grid.Column="0" Content="Роль"/>
        <ComboBox x:Name="comboBxRole" Grid.Row="4" Grid.Column="1" ToolTip="Выберите роль">
            <ComboBoxItem Content="User"/>
            <ComboBoxItem Content="Admin"/>
        </ComboBox>

        <Label Grid.Row="5" Grid.Column="0" Content="ФИО"/>
        <Grid Grid.Row="5" Grid.Column="1">
            <TextBox x:Name="txtbxFIO" ToolTip="Введите фамилию, имя и отчество"
                     TextChanged="txtbxFIO_TextChanged"/>
            <TextBlock x:Name="lblFioHitn" Text="Введите ФИО" Foreground="Gray"
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Grid>

        <Button x:Name="regButton" Grid.Row="6" Grid.Column="1" Width="200"
                Content="Зарегистрироваться" ToolTip="Создать учётную запись"
                Click="regButton_Click"/>
    </Grid>
</Page>
